# Copy this file to ``.env`` and fill in your provider API keys.
# ``.env`` is gitignored; ``.env.example`` is the committed template.
#
# Each key is OPTIONAL for the unit/property test suites — those tests
# never reach an LLM. Tests marked ``@pytest.mark.live`` for a given
# provider are skipped when its key is absent (see tests/conftest.py).
# Run live tests with: ``pytest -m live``
# Skip them by default: ``pytest -m "not live"`` (the default in CI).

# ── OpenRouter (REQUIRED for the OR live-test path) ──────────────
# Get a key at https://openrouter.ai/keys
# Recommended: set a credit cap on the key in the OR dashboard.
OPENROUTER_API_KEY=

# ── Anthropic Claude ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Postgres test DB (only for tests/integration/test_smoke_postgres.py) ──
# A throwaway local DB; the test creates + drops its own schema.
LLM_BENCH_TEST_DB_URL=postgresql://localhost:5432/llm_bench_test
